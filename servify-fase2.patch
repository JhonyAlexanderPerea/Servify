+                text = "Próximamente",
+                style = ServifyTextStyle.Title,
+                color = MaterialTheme.colorScheme.onSurface
+            )
+            Text(
+                text = description,
+                style = ServifyTextStyle.SmallRelaxed,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                textAlign = TextAlign.Center
+            )
+        }
+    }
+}
